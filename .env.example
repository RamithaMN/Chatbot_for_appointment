# =============================================================================
# Dental Chatbot Application - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Service Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
ENVIRONMENT=production

# Backend API
PORT=8000
BACKEND_HOST=0.0.0.0

# Chatbot Service
SERVICE_PORT=8001
SERVICE_HOST=0.0.0.0
CHATBOT_SERVICE_URL=http://localhost:8001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Generate a secure random key for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dental_chatbot
DB_USER=dental_user
DB_PASSWORD=change-this-secure-password
POSTGRES_INITDB_ARGS=--encoding=UTF-8

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Options: mock, openai, anthropic, local
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000
OPENAI_TOP_P=1.0
OPENAI_FREQUENCY_PENALTY=0.0
OPENAI_PRESENCE_PENALTY=0.0

# Anthropic/Claude Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=1000

# Local LLM Configuration (for open-source models)
LOCAL_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2
LOCAL_MODEL_PATH=/models
HUGGINGFACE_TOKEN=your-huggingface-token-here

# -----------------------------------------------------------------------------
# Conversation & Memory Settings
# -----------------------------------------------------------------------------
# Maximum number of previous messages to keep in context
MAX_CONVERSATION_HISTORY=10

# Memory type: buffer, summary, token, window
CONVERSATION_MEMORY_TYPE=buffer

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=30

# Maximum concurrent sessions per user
MAX_SESSIONS_PER_USER=5

# -----------------------------------------------------------------------------
# Chatbot Personality & Behavior
# -----------------------------------------------------------------------------
CHATBOT_NAME=DentalBot
CHATBOT_ROLE=friendly dental assistant
CHATBOT_DESCRIPTION=A helpful AI assistant for dental appointments and information

# Response settings
MAX_RESPONSE_LENGTH=500
ENABLE_FALLBACK_RESPONSES=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Per-user rate limiting
USER_RATE_LIMIT_WINDOW_MS=60000
USER_RATE_LIMIT_MAX_REQUESTS=30

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
LOG_FILE_PATH=./logs

# -----------------------------------------------------------------------------
# Vector Store & Embeddings (Optional)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-ada-002
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/vector_store

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - for production caching)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ENABLE_REDIS_CACHE=false

# -----------------------------------------------------------------------------
# Email Configuration (Optional - for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@dentalchatbot.com
ENABLE_EMAIL_NOTIFICATIONS=false

# -----------------------------------------------------------------------------
# Monitoring & Analytics (Optional)
# -----------------------------------------------------------------------------
ENABLE_ANALYTICS=true
SENTRY_DSN=
DATADOG_API_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_APPOINTMENTS=true
ENABLE_CHAT_HISTORY=true
ENABLE_USER_PROFILES=true
ENABLE_ADMIN_PANEL=false

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
DEBUG=false
MOCK_LLM_RESPONSES=false
TEST_MODE=false

# -----------------------------------------------------------------------------
# Docker-specific
# -----------------------------------------------------------------------------
DOCKER_BUILDKIT=1
COMPOSE_PROJECT_NAME=dental-chatbot

